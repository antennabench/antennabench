#!/usr/bin/env bash
# -*- mode: sh; sh-shell: bash; -*-
#MISE description="Download and authenticate the five actual private draft assets without native execution"
#USAGE arg "<tag>" help="Exact vMAJOR.MINOR.PATCH release tag"
#USAGE arg "<output>" help="Clean directory for downloaded release assets"
#USAGE arg "<expected-commit>" help="Full commit SHA of the tagged release source"
#USAGE flag "--root <root>" help="Separate tagged source checkout to validate" default="."

set -euo pipefail

node scripts/desktop-publication.mjs download-draft \
  --tag "$usage_tag" \
  --output "$usage_output" \
  --expected-commit "$usage_expected_commit" \
  --root "$usage_root"
