#!/usr/bin/env bash
# -*- mode: sh; sh-shell: bash; -*-
#MISE description="Assemble three verified native artifacts into a complete release set"
#USAGE arg "<arm64>" help="Directory containing the arm64 artifact manifest"
#USAGE arg "<intel>" help="Directory containing the Intel artifact manifest"
#USAGE arg "<windows>" help="Directory containing the Windows x64 installer manifest"
#USAGE flag "--require-publishable" help="Require verified target artifacts under their explicit release signature policies"

set -euo pipefail

args=(assemble --input "$usage_arm64" --input "$usage_intel" --input "$usage_windows")
if [[ "${usage_require_publishable:-false}" == "true" ]]; then
  args+=(--require-publishable)
fi
node scripts/desktop-release.mjs "${args[@]}"
